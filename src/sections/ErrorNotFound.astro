---
const CLASS_ERROR_CODE = 'mb-[clamp(24px,calc(16px+2.5vw),48px)] font-normal font-serif leading-none text-[clamp(96px,calc(48px+15vw),240px)] bg-clip-text bg-linear-to-b from-ink text-transparent to-storm';
---

<section
    class="flex flex-1 items-center justify-center px-[var(--shell-pad)] py-[clamp(24px,10svh,96px)]"
    aria-labelledby="error-not-found-title"
>
    <div class="text-center select-none">
        <h1
            id="error-not-found-title"
            class={CLASS_ERROR_CODE}
        >
            404
        </h1>
        <a
            class="pill min-h-[48px] px-[28px] font-mono text-[16px] tracking-[0.2em] uppercase text-slate"
            aria-label="Return to home"
            href="/"
        >
            Home
        </a>
    </div>
</section>
