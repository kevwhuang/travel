---
import '@fontsource/fragment-mono/400.css';
import '@fontsource/gloock/400.css';
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import { ClientRouter } from 'astro:transitions';

import '@/global.css';
import '@/styles.css';
import { ROUTES } from '@lib/constants';

interface Props {
    description: string;
    noindex?: boolean;
    title: string;
}

const canonicalUrl = new URL(Astro.routePattern, Astro.site);
const currentRoute = ROUTES.find(route => route.href === Astro.routePattern);
const { description, noindex, title } = Astro.props;
const ogImageUrl = `${Astro.site}og.png`;

const breadcrumbRoutes = currentRoute && currentRoute !== ROUTES[0] ? [ROUTES[0], currentRoute] : [];

const breadcrumbList = {
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbRoutes.map((route, index) => ({
        '@type': 'ListItem',
        'item': new URL(route.href, Astro.site).href,
        'name': route.label,
        'position': index + 1,
    })),
};

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        ...(breadcrumbRoutes.length > 0 ? [breadcrumbList] : []),
        {
            '@type': 'ItemList',
            'itemListElement': ROUTES.map((route, index) => ({
                '@type': 'SiteNavigationElement',
                'name': route.label,
                'position': index + 1,
                'url': new URL(route.href, Astro.site).href,
            })),
        },
        {
            '@type': 'WebSite',
            'author': {
                '@type': 'Person',
                'name': 'Kevin Huang',
            },
            'inLanguage': 'en',
            'name': 'Travel',
            'url': Astro.site,
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta content="Kevin Huang" name="author" />
        <meta content={description} name="description" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <meta content="#f3f5f4" name="theme-color" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content="en_US" property="og:locale" />
        <meta content="Travel" property="og:site_name" />
        <meta content={title} property="og:title" />
        <meta content="website" property="og:type" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <meta content={title} name="twitter:title" />
        <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
        <ClientRouter />
    </head>
    <body class="flex flex-col min-h-svh antialiased font-sans bg-paper text-ink">
        <main class="flex flex-1 flex-col">
            <slot />
        </main>
    </body>
</html>
